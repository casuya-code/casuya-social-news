# Casuya Social News — Environment Variables
# Copy to .env and fill in your values

# =============================================================================
# APP
# =============================================================================
APP_ENV=development              # development | staging | production
APP_DEBUG=true
APP_PORT=8000
APP_SECRET_KEY=change-me-to-random-64-char-string

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://casuya_user:password@localhost:5432/casuya_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS (optional — set to empty to use in-memory fallback)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AUTH
# =============================================================================
JWT_SECRET_KEY=change-me-to-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440    # 24 hours
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# API key for client authentication (Godot client sends this header)
API_KEY=change-me-to-random-32-char-string

# JWT operator sessions — credentials accepted by POST /api/v1/auth/login
# (no user table yet; these live in settings until a user store exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# =============================================================================
# TTS PROVIDER (choose one: mock | google_cloud | elevenlabs)
# =============================================================================
TTS_PROVIDER=mock                        # mock (offline dev) | google_cloud | elevenlabs

# Google Cloud TTS (default — $4/1M chars, 4M free/mo)
# Set up: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json  # Uncomment for local dev

# ElevenLabs (premium — $50/1M chars, best quality)
# Set up: https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_MONTHLY_BUDGET_USD=50.00     # Hard cap — pause voice gen when hit

# OpenAI (optional — for GPT-based script generation)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# NLP — script generation timeout (seconds; raises E1003 when exceeded)
SCRIPT_GENERATION_TIMEOUT_SECONDS=30

# News API (optional — for live news fetching)
NEWS_API_KEY=your-newsapi-key

# =============================================================================
# WEATHER (optional — for diurnal mood drift)
# =============================================================================
OPENWEATHER_API_KEY=your-openweather-key

# =============================================================================
# FILE STORAGE
# =============================================================================
# Local: files stored in ./storage/
# S3: set these for production
STORAGE_BACKEND=local                  # local | s3
STORAGE_LOCAL_PATH=./storage
# STORAGE_S3_BUCKET=casuya-audio-assets
# STORAGE_S3_REGION=eu-central-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# =============================================================================
# CDN (for serving audio files to clients)
# =============================================================================
CDN_BASE_URL=http://localhost:8000/storage   # No CDN in development

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_API=60/minute               # Per IP for general API
RATE_LIMIT_VOICE=5/minute              # Per IP for voice generation

# =============================================================================
# BACKGROUND SCHEDULER (endless-stories loop)
# =============================================================================
SCHEDULER_ENABLED=true                 # Run the story loop on a timer
SCHEDULER_INTERVAL_SECONDS=300         # Seconds between ingest cycles

# =============================================================================
# OBSERVABILITY (Prometheus + Grafana, see infra/docker)
# =============================================================================
# /metrics is always exposed on the server; these are used by the compose stack.
# Prometheus UI:  http://localhost:9090   (scrapes /metrics every 15s)
# Grafana UI:     http://localhost:3000   (admin / casuya)
# Alert rules:    infra/docker/monitoring/prometheus/alerting_rules.yml

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                        # json | text
